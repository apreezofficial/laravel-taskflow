{
    "name": "apreezofficial/laravel-taskflow",
    "description": "A production-quality asynchronous job processing system for Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Antigravity",
            "email": "antigravity@google.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Apreezofficial\\LaravelTaskflow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Apreezofficial\\LaravelTaskflow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Apreezofficial\\LaravelTaskflow\\TaskflowServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
